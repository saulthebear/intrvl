# Database Configuration
# These are used by docker-compose to set up PostgreSQL
DB_NAME=intrvl
DB_USER=intrvl
DB_PASSWORD=your_secure_password_here

# The app uses DATABASE_URL in production (constructed from above vars in docker-compose)
# If running outside Docker, set this directly:
# DATABASE_URL=postgres://user:password@localhost:5432/intrvl

# Application Security
# Used for session encryption - generate a strong random string
# Generate with: openssl rand -base64 48
ENC_KEY=your_encryption_key_here

# Google Cloud Text-to-Speech (Optional)
# The app has a Web Speech API fallback, so this is not required
# If you want server-side TTS, create a service account and set the path
# GOOGLE_APPLICATION_CREDENTIALS=/app/google-credentials.json

# Runtime Configuration (defaults shown)
# NODE_ENV=production
# PORT=3333
