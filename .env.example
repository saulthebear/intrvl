# Database Configuration
# These variables are used by both PostgreSQL container and the app
# IMPORTANT: Generate a strong password with: openssl rand -base64 32
# No need to URL-encode - the app reads these as individual environment variables
DB_NAME=intrvl
DB_USER=intrvl
DB_PASSWORD=your_secure_password_here

# Application Security
# Used for session encryption - generate a strong random string
# Generate with: openssl rand -base64 48
ENC_KEY=your_encryption_key_here

# Google Cloud Text-to-Speech (Optional)
# The app has a Web Speech API fallback, so this is not required
# If you want server-side TTS:
# 1. Create a Google Cloud service account with Text-to-Speech API access
# 2. Download the JSON key file as cloud-service-account-file.json
# 3. Uncomment the line below
# GOOGLE_APPLICATION_CREDENTIALS=/app/cloud-service-account-file.json

# Runtime Configuration (defaults shown)
# NODE_ENV=production
# PORT=3333
