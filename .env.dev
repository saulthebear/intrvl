# Development Environment Configuration
# Copy this to .env for local testing: cp .env.dev .env

# Database Configuration (matches docker-compose.dev.yml defaults)
DB_NAME=intrvl_dev
DB_USER=intrvl
DB_PASSWORD=devpassword

# Application Security
# Generate a proper key with: openssl rand -base64 48
# For local dev, this is a placeholder (DO NOT USE IN PRODUCTION)
ENC_KEY=dev_encryption_key_replace_in_production_with_secure_random_string

# Runtime Configuration
NODE_ENV=development
PORT=3333

# Base path (leave empty for local dev)
BASE_PATH=

# Google Cloud TTS (Optional - app has Web Speech API fallback)
# GOOGLE_APPLICATION_CREDENTIALS=/app/cloud-service-account-file.json
